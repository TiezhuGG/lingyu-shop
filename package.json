{
  "name": "lingyu-shop",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "check": "node scripts/check-workspace.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "contracts:verify": "pnpm --filter @lingyu/contracts verify:generated",
    "test": "node --test tests/integration/runtime.test.mjs tests/integration/database-tools.test.mjs tests/integration/foundation.test.mjs tests/integration/http-boundary.test.mjs tests/integration/transaction-audit.test.mjs",
    "dev:admin": "pnpm --filter @lingyu/admin dev",
    "dev:api": "pnpm --filter @lingyu/api dev",
    "dev:miniapp": "pnpm --filter @lingyu/miniapp dev:mp-weixin",
    "dev:worker": "pnpm --filter @lingyu/worker dev",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy --config packages/server-modules/prisma.config.ts",
    "db:poc": "node --env-file-if-exists=.env scripts/database-poc.mjs",
    "redis:poc": "node scripts/redis-poc.mjs",
    "db:init:local": "node --env-file-if-exists=.env scripts/init-local-databases.mjs",
    "test:database": "node --env-file-if-exists=.env scripts/test-database.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.0",
    "prisma": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.1"
  }
}
