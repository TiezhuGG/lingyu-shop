# Local development only. Replace placeholders; never commit .env.
NODE_ENV=development
DATABASE_URL=postgresql://lingyu_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:15432/lingyu_shop
REDIS_URL=redis://127.0.0.1:16379
# Dedicated engineering DB; never use it as the business database.
POC_DATABASE_URL=postgresql://lingyu_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:15432/lingyu_shop_poc
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
# Defaults per API/Worker process; combined default pool budget is 10 + operations.
DB_POOL_MAX=5
DB_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
PORT=3000
# Authentication keys must be distinct, random base64url values that decode to at least 32 bytes.
# For example, generate each locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_ACCESS_SIGNING_KEY=REPLACE_WITH_RANDOM_BASE64URL_KEY
AUTH_REFRESH_TOKEN_PEPPER=REPLACE_WITH_DISTINCT_RANDOM_BASE64URL_KEY
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
# Development identities are disabled by default and must never be enabled in production.
AUTH_DEVELOPMENT_LOGIN_ENABLED=false
# Exact browser origin for admin writes/CSRF checks. Production requires explicit HTTPS.
ADMIN_ORIGIN=http://127.0.0.1:5173
# Miniapp: supply public VITE_API_BASE_URL in the build process for native targets.
# Use HTTPS in production; never include credentials, query parameters or secrets.
# admin:bootstrap reads ADMIN_BOOTSTRAP_USERNAME/PASSWORD from process environment.
# Do not persist bootstrap credentials. It refuses existing administrators and production.
