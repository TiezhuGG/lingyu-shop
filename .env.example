# Local development only. Replace placeholders; never commit .env.
NODE_ENV=development
DATABASE_URL=postgresql://lingyu_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:15432/lingyu_shop
REDIS_URL=redis://127.0.0.1:16379
# Dedicated engineering DB; never use it as the business database.
POC_DATABASE_URL=postgresql://lingyu_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:15432/lingyu_shop_poc
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
# Defaults per API/Worker process; combined default pool budget is 10 + operations.
DB_POOL_MAX=5
DB_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
PORT=3000
