{
  "openapi": "3.1.0",
  "info": {
    "title": "Lingyu app API",
    "version": "0.3.0",
    "description": "Independent customer/admin sessions, scoped IAM and an isolated engineering contract probe. Admin writes require an exact configured Origin; authenticated writes also require the CSRF value returned by login/me."
  },
  "paths": {
    "/api/v1/app/storefront": {"get": {"operationId": "getPublicStorefront", "responses": {"200": {"description": "Online sales scope; drafts do not enable fulfillment or checkout", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StorefrontSuccess"}}}}}}},
    "/api/v1/admin/storefront": {
      "get": {"operationId": "getAdminStorefront", "security": [{"AdminCookie": []}], "responses": {"200": {"description": "Authorized settings and three fulfillment drafts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StorefrontAdminSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}},
      "put": {"operationId": "saveStorefront", "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}], "security": [{"AdminCookie": [], "AdminCsrf": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StorefrontUpdateRequest"}}}}, "responses": {"200": {"description": "Versioned settings committed with audit", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StorefrontSavedSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}
    },
    "/api/v1/admin/auth/login": {"post": {"operationId": "adminLogin", "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminLoginRequest"}}}}, "responses": {"200": {"description": "HttpOnly session cookie and CSRF state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminSessionSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/auth/me": {"get": {"operationId": "adminMe", "security": [{"AdminCookie": []}], "responses": {"200": {"description": "Live administrator identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminSessionSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/auth/logout": {"post": {"operationId": "adminLogout", "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}], "security": [{"AdminCookie": [], "AdminCsrf": []}], "responses": {"200": {"description": "Session revoked", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptySuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/iam/admins": {
      "get": {"operationId": "listAdmins", "security": [{"AdminCookie": []}], "responses": {"200": {"description": "At most 100 administrators, username order", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminListSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}},
      "post": {"operationId": "createAdmin", "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}], "security": [{"AdminCookie": [], "AdminCsrf": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminCreateRequest"}}}}, "responses": {"200": {"description": "Created administrator", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminAccountSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}
    },
    "/api/v1/admin/iam/admins/{id}": {"patch": {"operationId": "updateAdmin", "security": [{"AdminCookie": [], "AdminCsrf": []}], "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}, {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminUpdateRequest"}}}}, "responses": {"200": {"description": "Updated administrator, previous sessions revoked", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminAccountSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/iam/audit": {"get": {"operationId": "adminAudit", "security": [{"AdminCookie": []}], "responses": {"200": {"description": "Latest 50 sanitized audit records", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminAuditSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/_access/stores/{storeId}": {"get": {"operationId": "adminStoreAccess", "security": [{"AdminCookie": []}], "parameters": [{"name": "storeId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Authorization only; does not assert store existence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptySuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/app/auth/development-login": {
      "post": {
        "operationId": "developmentLogin",
        "summary": "Create a development-only customer session",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DevelopmentLoginRequest"}}}},
        "responses": {
          "200": {"description": "Customer session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AppSessionSuccess"}}}},
          "400": {"description": "Invalid request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}},
          "404": {"description": "Development login is unavailable", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    },
    "/api/v1/app/auth/refresh": {
      "post": {
        "operationId": "refreshAppSession",
        "summary": "Rotate an app customer refresh token",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshSessionRequest"}}}},
        "responses": {
          "200": {"description": "Rotated customer session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AppSessionSuccess"}}}},
          "400": {"description": "Invalid request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}},
          "401": {"description": "Invalid or replayed refresh token", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    },
    "/api/v1/app/auth/logout": {
      "post": {
        "operationId": "logoutAppSession",
        "summary": "Revoke the current app customer session",
        "responses": {
          "200": {"description": "Session revoked", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptySuccess"}}}},
          "401": {"description": "Authentication is required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    },
    "/api/v1/app/auth/me": {
      "get": {
        "operationId": "getCurrentAppCustomer",
        "summary": "Read the current app customer session identity",
        "responses": {
          "200": {"description": "Current customer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CurrentCustomerSuccess"}}}},
          "401": {"description": "Authentication is required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    },
    "/api/v1/_contract/probe": {
      "post": {
        "operationId": "contractProbe",
        "summary": "Validate the generated engineering contract without business side effects",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContractProbeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated probe input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractProbeSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Input does not match the public schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Safe internal error boundary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {"AdminOrigin": {"name": "Origin", "in": "header", "required": true, "description": "Exact configured ADMIN_ORIGIN; browser supplies this header.", "schema": {"type": "string"}}},
    "responses": {"AdminError": {"description": "Standard safe error envelope (400/401/403/404/409/429/500/503)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}},
    "securitySchemes": {
      "AdminCookie": {"type": "apiKey", "in": "cookie", "name": "__Host-lingyu-admin", "description": "Development HTTP uses lingyu_admin. Independent of customer credentials."},
      "AdminCsrf": {"type": "apiKey", "in": "header", "name": "X-CSRF-Token", "description": "Session-derived value returned by login/me; required together with the HttpOnly cookie for authenticated writes."}
    },
    "schemas": {
      "FulfillmentMethod": {"type": "string", "enum": ["EXPRESS", "LOCAL_DELIVERY", "PICKUP"]},
      "DraftMinor": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]{0,11})$", "description": "Integer minor units, null means undecided (not free)."},
      "FulfillmentRuleDraft": {"type": "object", "additionalProperties": false, "required": ["method", "feeMinor", "freeAboveMinor", "serviceDescription", "pickupAddress"], "properties": {"method": {"$ref": "#/components/schemas/FulfillmentMethod"}, "feeMinor": {"$ref": "#/components/schemas/DraftMinor"}, "freeAboveMinor": {"$ref": "#/components/schemas/DraftMinor"}, "serviceDescription": {"type": ["string", "null"], "maxLength": 500, "pattern": "^[^\\u0000]*$"}, "pickupAddress": {"type": ["string", "null"], "maxLength": 200, "pattern": "^[^\\u0000]*$"}}},
      "FulfillmentDrafts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/components/schemas/FulfillmentRuleDraft"}},
      "StorefrontData": {"type": "object", "additionalProperties": false, "required": ["storeId", "mode", "configured", "displayName", "version", "fulfillmentMethods", "enabledMethods", "physicalStoreEnabled", "checkoutEnabled"], "properties": {"storeId": {"type": "string"}, "mode": {"const": "ONLINE"}, "configured": {"type": "boolean"}, "displayName": {"type": ["string", "null"]}, "version": {"type": "integer"}, "fulfillmentMethods": {"type": "array", "items": {"$ref": "#/components/schemas/FulfillmentMethod"}}, "enabledMethods": {"type": "array", "maxItems": 0, "items": {"$ref": "#/components/schemas/FulfillmentMethod"}}, "physicalStoreEnabled": {"const": false}, "checkoutEnabled": {"const": false}}},
      "StorefrontAdminData": {"type": "object", "additionalProperties": false, "required": ["storefront", "fulfillmentRules"], "properties": {"storefront": {"$ref": "#/components/schemas/StorefrontData"}, "fulfillmentRules": {"$ref": "#/components/schemas/FulfillmentDrafts"}}},
      "StorefrontUpdateRequest": {"type": "object", "additionalProperties": false, "required": ["version", "displayName", "fulfillmentRules", "reason"], "properties": {"version": {"type": "integer", "minimum": 0, "maximum": 2147483646}, "displayName": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, "fulfillmentRules": {"$ref": "#/components/schemas/FulfillmentDrafts"}, "reason": {"const": "configuration_change"}}},
      "StorefrontSavedData": {"type": "object", "additionalProperties": false, "required": ["settings", "auditId"], "properties": {"settings": {"$ref": "#/components/schemas/StorefrontAdminData"}, "auditId": {"type": "string"}}},
      "StorefrontSuccess": {"type": "object", "required": ["code", "data", "requestId"], "additionalProperties": false, "properties": {"code": {"const": "OK"}, "data": {"$ref": "#/components/schemas/StorefrontData"}, "requestId": {"$ref": "#/components/schemas/RequestId"}}},
      "StorefrontAdminSuccess": {"type": "object", "required": ["code", "data", "requestId"], "additionalProperties": false, "properties": {"code": {"const": "OK"}, "data": {"$ref": "#/components/schemas/StorefrontAdminData"}, "requestId": {"$ref": "#/components/schemas/RequestId"}}},
      "StorefrontSavedSuccess": {"type": "object", "required": ["code", "data", "requestId"], "additionalProperties": false, "properties": {"code": {"const": "OK"}, "data": {"$ref": "#/components/schemas/StorefrontSavedData"}, "requestId": {"$ref": "#/components/schemas/RequestId"}}},
      "AdminRoleName": {"type": "string", "enum": ["IAM_MANAGER", "STORE_OPERATOR", "STORE_READER"]},
      "AdminStatus": {"type": "string", "enum": ["ACTIVE", "DISABLED"]},
      "AdminReason": {"type": "string", "enum": ["onboarding", "access_change", "offboarding", "security"]},
      "AdminUsername": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
      "AdminPassword": {"type": "string", "minLength": 12, "maxLength": 128},
      "AdminGrantInput": {"type": "object", "additionalProperties": false, "required": ["role", "scopeKey"], "properties": {"role": {"$ref": "#/components/schemas/AdminRoleName"}, "scopeKey": {"type": "string", "minLength": 6, "maxLength": 36, "pattern": "^(GLOBAL|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"}}},
      "AdminGrants": {"type": "array", "maxItems": 30, "items": {"$ref": "#/components/schemas/AdminGrantInput"}},
      "AdminLoginRequest": {"type": "object", "additionalProperties": false, "required": ["username", "password"], "properties": {"username": {"$ref": "#/components/schemas/AdminUsername"}, "password": {"$ref": "#/components/schemas/AdminPassword"}}},
      "AdminCreateRequest": {"type": "object", "additionalProperties": false, "required": ["username", "password", "grants", "reason"], "properties": {"username": {"$ref": "#/components/schemas/AdminUsername"}, "password": {"$ref": "#/components/schemas/AdminPassword"}, "grants": {"$ref": "#/components/schemas/AdminGrants"}, "reason": {"$ref": "#/components/schemas/AdminReason"}}},
      "AdminUpdateRequest": {"type": "object", "additionalProperties": false, "required": ["version", "status", "grants", "reason"], "properties": {"version": {"type": "integer", "minimum": 1, "maximum": 2147483646}, "status": {"$ref": "#/components/schemas/AdminStatus"}, "grants": {"$ref": "#/components/schemas/AdminGrants"}, "reason": {"$ref": "#/components/schemas/AdminReason"}}},
      "AdminAccountData": {"type": "object", "additionalProperties": false, "required": ["id", "username", "status", "version", "grants"], "properties": {"id": {"type": "string"}, "username": {"$ref": "#/components/schemas/AdminUsername"}, "status": {"$ref": "#/components/schemas/AdminStatus"}, "version": {"type": "integer"}, "grants": {"$ref": "#/components/schemas/AdminGrants"}}},
      "AdminSessionData": {"type": "object", "additionalProperties": false, "required": ["admin", "csrfToken", "expiresAt"], "properties": {"admin": {"$ref": "#/components/schemas/AdminAccountData"}, "csrfToken": {"type": "string"}, "expiresAt": {"type": "string"}}},
      "AdminSessionSuccess": {"type": "object", "additionalProperties": false, "required": ["code", "data", "requestId"], "properties": {"code": {"const": "OK"}, "data": {"$ref": "#/components/schemas/AdminSessionData"}, "requestId": {"$ref": "#/components/schemas/RequestId"}}},
      "AdminAccountSuccess": {"type": "object", "additionalProperties": false, "required": ["code", "data", "requestId"], "properties": {"code": {"const": "OK"}, "data": {"$ref": "#/components/schemas/AdminAccountData"}, "requestId": {"$ref": "#/components/schemas/RequestId"}}},
      "AdminListSuccess": {"type": "object", "additionalProperties": false, "required": ["code", "data", "requestId"], "properties": {"code": {"const": "OK"}, "data": {"type": "array", "items": {"$ref": "#/components/schemas/AdminAccountData"}}, "requestId": {"$ref": "#/components/schemas/RequestId"}}},
      "AdminAuditItem": {"type": "object", "additionalProperties": false, "required": ["id", "action", "objectType", "objectId", "createdAt"], "properties": {"id": {"type": "string"}, "action": {"type": "string"}, "objectType": {"type": "string"}, "objectId": {"type": "string"}, "actorId": {"type": ["string", "null"]}, "requestId": {"type": ["string", "null"]}, "createdAt": {"type": "string"}, "changes": {"type": ["object", "null"], "additionalProperties": true}}},
      "AdminAuditSuccess": {"type": "object", "additionalProperties": false, "required": ["code", "data", "requestId"], "properties": {"code": {"const": "OK"}, "data": {"type": "array", "items": {"$ref": "#/components/schemas/AdminAuditItem"}}, "requestId": {"$ref": "#/components/schemas/RequestId"}}},
      "RequestId": {
        "type": "string",
        "minLength": 8,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"
      },
      "AmountMinor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12,
        "pattern": "^(0|[1-9][0-9]*)$",
        "description": "Non-negative decimal integer in minor currency units; never a JSON number."
      },
      "DeliveryMode": {
        "type": "string",
        "enum": ["pickup", "delivery"]
      },
      "DevelopmentLoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["developmentId"],
        "properties": {
          "developmentId": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"}
        }
      },
      "RefreshSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {"type": "string", "minLength": 80, "maxLength": 80, "pattern": "^[0-9a-fA-F-]{36}\\.[A-Za-z0-9_-]{43}$"}
        }
      },
      "IsoTimestamp": {
        "type": "string",
        "minLength": 20,
        "maxLength": 40
      },
      "AppSessionData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accessToken", "refreshToken", "accessExpiresAt", "refreshExpiresAt"],
        "properties": {
          "accessToken": {"type": "string", "minLength": 20, "maxLength": 4096},
          "refreshToken": {"type": "string", "minLength": 80, "maxLength": 160},
          "accessExpiresAt": {"$ref": "#/components/schemas/IsoTimestamp"},
          "refreshExpiresAt": {"$ref": "#/components/schemas/IsoTimestamp"}
        }
      },
      "AppSessionSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "data", "requestId"],
        "properties": {
          "code": {"const": "OK"},
          "data": {"$ref": "#/components/schemas/AppSessionData"},
          "requestId": {"$ref": "#/components/schemas/RequestId"}
        }
      },
      "EmptySuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "data", "requestId"],
        "properties": {
          "code": {"const": "OK"},
          "data": {"type": "object", "additionalProperties": false},
          "requestId": {"$ref": "#/components/schemas/RequestId"}
        }
      },
      "CurrentCustomerData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["customerId", "sessionId"],
        "properties": {
          "customerId": {"type": "string", "minLength": 36, "maxLength": 36},
          "sessionId": {"type": "string", "minLength": 36, "maxLength": 36}
        }
      },
      "CurrentCustomerSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "data", "requestId"],
        "properties": {
          "code": {"const": "OK"},
          "data": {"$ref": "#/components/schemas/CurrentCustomerData"},
          "requestId": {"$ref": "#/components/schemas/RequestId"}
        }
      },
      "ContractProbeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amountMinor", "deliveryMode"],
        "properties": {
          "amountMinor": {
            "$ref": "#/components/schemas/AmountMinor"
          },
          "deliveryMode": {
            "$ref": "#/components/schemas/DeliveryMode"
          }
        }
      },
      "ContractProbeData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amountMinor", "deliveryMode"],
        "properties": {
          "amountMinor": {
            "$ref": "#/components/schemas/AmountMinor"
          },
          "deliveryMode": {
            "$ref": "#/components/schemas/DeliveryMode"
          }
        }
      },
      "ContractProbeSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "data", "requestId"],
        "properties": {
          "code": {
            "const": "OK"
          },
          "data": {
            "$ref": "#/components/schemas/ContractProbeData"
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "ValidationField": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "rule"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]*$"
          },
          "rule": {
            "type": "string",
            "enum": ["additionalProperties", "enum", "maxLength", "minLength", "pattern", "required", "type"]
          }
        }
      },
      "ValidationDetails": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fields"],
        "properties": {
          "fields": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/ValidationField"
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "requestId"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["CONFLICT", "FORBIDDEN", "INTERNAL_ERROR", "NOT_FOUND", "RATE_LIMITED", "SERVICE_UNAVAILABLE", "UNAUTHENTICATED", "VALIDATION_FAILED"]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          },
          "details": {
            "$ref": "#/components/schemas/ValidationDetails"
          }
        }
      }
    }
  }
}
