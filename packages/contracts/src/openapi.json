{
  "openapi": "3.1.0",
  "info": {
    "title": "Lingyu app API",
    "version": "0.3.0",
    "description": "Independent customer/admin sessions, scoped IAM and an isolated engineering contract probe. Admin writes require an exact configured Origin; authenticated writes also require the CSRF value returned by login/me."
  },
  "paths": {
    "/api/v1/app/cms/{pageCode}": {"get": {"operationId": "readPublishedText", "parameters": [{"$ref": "#/components/parameters/CmsPageCode"}], "responses": {"200": {"description": "Published text or empty, never draft or consent", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CmsPublicSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/cms/{pageCode}": {
      "get": {"operationId": "readTextDraft", "security": [{"AdminCookie": []}], "parameters": [{"$ref": "#/components/parameters/CmsPageCode"}, {"name": "before", "in": "query", "schema": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"}}], "responses": {"200": {"description": "Draft, publication and ten history records with cursor", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CmsAdminSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}},
      "put": {"operationId": "saveTextDraft", "security": [{"AdminCookie": [], "AdminCsrf": []}], "parameters": [{"$ref": "#/components/parameters/CmsPageCode"}, {"$ref": "#/components/parameters/AdminOrigin"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CmsSaveRequest"}}}}, "responses": {"200": {"description": "Draft saved with audit", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CmsSavedSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}
    },
    "/api/v1/admin/cms/{pageCode}/publish": {"post": {"operationId": "publishText", "security": [{"AdminCookie": [], "AdminCsrf": []}], "parameters": [{"$ref": "#/components/parameters/CmsPageCode"}, {"$ref": "#/components/parameters/AdminOrigin"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CmsPublicationRequest"}}}}, "responses": {"200": {"description": "New immutable publication", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CmsSavedSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/cms/{pageCode}/rollback": {"post": {"operationId": "rollbackText", "security": [{"AdminCookie": [], "AdminCsrf": []}], "parameters": [{"$ref": "#/components/parameters/CmsPageCode"}, {"$ref": "#/components/parameters/AdminOrigin"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CmsRollbackRequest"}}}}, "responses": {"200": {"description": "Copy history to new publication, draft unchanged", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CmsSavedSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/cms/{pageCode}/withdraw": {"post": {"operationId": "withdrawText", "security": [{"AdminCookie": [], "AdminCsrf": []}], "parameters": [{"$ref": "#/components/parameters/CmsPageCode"}, {"$ref": "#/components/parameters/AdminOrigin"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CmsPublicationRequest"}}}}, "responses": {"200": {"description": "Clear publication pointer, retain history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CmsSavedSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/app/products": {"get": {"operationId": "listPublishedProducts", "parameters": [{"$ref": "#/components/parameters/CatalogCursor"}, {"$ref": "#/components/parameters/CatalogLimit"}], "responses": {"200": {"description": "Published snapshots and matching integer-minor price versions; no inventory or checkout promise", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogPublicSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/catalog": {"get": {"operationId": "listCatalogDrafts", "security": [{"AdminCookie": []}], "parameters": [{"$ref": "#/components/parameters/CatalogCursor"}, {"$ref": "#/components/parameters/CatalogLimit"}], "responses": {"200": {"description": "Scoped categories and a page of product draft summaries", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogAdminSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/catalog/categories/{id}": {"put": {"operationId": "saveCatalogCategory", "security": [{"AdminCookie": [], "AdminCsrf": []}], "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}, {"$ref": "#/components/parameters/CatalogId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogCategoryRequest"}}}}, "responses": {"200": {"description": "Versioned classification configuration and audit", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogCategorySavedSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/catalog/products/{id}": {
      "get": {"operationId": "getCatalogDraft", "security": [{"AdminCookie": []}], "parameters": [{"$ref": "#/components/parameters/CatalogId"}], "responses": {"200": {"description": "Product draft, never a public snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogDraftSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}},
      "put": {"operationId": "saveCatalogDraft", "security": [{"AdminCookie": [], "AdminCsrf": []}], "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}, {"$ref": "#/components/parameters/CatalogId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogProductRequest"}}}}, "responses": {"200": {"description": "Draft and price changes committed with audit", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogSavedSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}
    },
    "/api/v1/admin/catalog/products/{id}/publish": {"post": {"operationId": "publishCatalogProduct", "security": [{"AdminCookie": [], "AdminCsrf": []}], "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}, {"$ref": "#/components/parameters/CatalogId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogPublicationRequest"}}}}, "responses": {"200": {"description": "Immutable product and price version atomically published", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogSavedSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/catalog/products/{id}/withdraw": {"post": {"operationId": "withdrawCatalogProduct", "security": [{"AdminCookie": [], "AdminCsrf": []}], "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}, {"$ref": "#/components/parameters/CatalogId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogPublicationRequest"}}}}, "responses": {"200": {"description": "Public pointer removed; history retained", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogSavedSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/app/storefront": {"get": {"operationId": "getPublicStorefront", "responses": {"200": {"description": "Online sales scope; drafts do not enable fulfillment or checkout", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StorefrontSuccess"}}}}}}},
    "/api/v1/admin/storefront": {
      "get": {"operationId": "getAdminStorefront", "security": [{"AdminCookie": []}], "responses": {"200": {"description": "Authorized settings and three fulfillment drafts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StorefrontAdminSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}},
      "put": {"operationId": "saveStorefront", "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}], "security": [{"AdminCookie": [], "AdminCsrf": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StorefrontUpdateRequest"}}}}, "responses": {"200": {"description": "Versioned settings committed with audit", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StorefrontSavedSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}
    },
    "/api/v1/admin/auth/login": {"post": {"operationId": "adminLogin", "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminLoginRequest"}}}}, "responses": {"200": {"description": "HttpOnly session cookie and CSRF state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminSessionSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/auth/me": {"get": {"operationId": "adminMe", "security": [{"AdminCookie": []}], "responses": {"200": {"description": "Live administrator identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminSessionSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/auth/logout": {"post": {"operationId": "adminLogout", "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}], "security": [{"AdminCookie": [], "AdminCsrf": []}], "responses": {"200": {"description": "Session revoked", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptySuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/iam/admins": {
      "get": {"operationId": "listAdmins", "security": [{"AdminCookie": []}], "responses": {"200": {"description": "At most 100 administrators, username order", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminListSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}},
      "post": {"operationId": "createAdmin", "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}], "security": [{"AdminCookie": [], "AdminCsrf": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminCreateRequest"}}}}, "responses": {"200": {"description": "Created administrator", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminAccountSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}
    },
    "/api/v1/admin/iam/admins/{id}": {"patch": {"operationId": "updateAdmin", "security": [{"AdminCookie": [], "AdminCsrf": []}], "parameters": [{"$ref": "#/components/parameters/AdminOrigin"}, {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminUpdateRequest"}}}}, "responses": {"200": {"description": "Updated administrator, previous sessions revoked", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminAccountSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/iam/audit": {"get": {"operationId": "adminAudit", "security": [{"AdminCookie": []}], "responses": {"200": {"description": "Latest 50 sanitized audit records", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminAuditSuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/admin/_access/stores/{storeId}": {"get": {"operationId": "adminStoreAccess", "security": [{"AdminCookie": []}], "parameters": [{"name": "storeId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Authorization only; does not assert store existence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptySuccess"}}}}, "default": {"$ref": "#/components/responses/AdminError"}}}},
    "/api/v1/app/auth/development-login": {
      "post": {
        "operationId": "developmentLogin",
        "summary": "Create a development-only customer session",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DevelopmentLoginRequest"}}}},
        "responses": {
          "200": {"description": "Customer session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AppSessionSuccess"}}}},
          "400": {"description": "Invalid request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}},
          "404": {"description": "Development login is unavailable", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    },
    "/api/v1/app/auth/refresh": {
      "post": {
        "operationId": "refreshAppSession",
        "summary": "Rotate an app customer refresh token",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshSessionRequest"}}}},
        "responses": {
          "200": {"description": "Rotated customer session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AppSessionSuccess"}}}},
          "400": {"description": "Invalid request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}},
          "401": {"description": "Invalid or replayed refresh token", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    },
    "/api/v1/app/auth/logout": {
      "post": {
        "operationId": "logoutAppSession",
        "summary": "Revoke the current app customer session",
        "responses": {
          "200": {"description": "Session revoked", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmptySuccess"}}}},
          "401": {"description": "Authentication is required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    },
    "/api/v1/app/auth/me": {
      "get": {
        "operationId": "getCurrentAppCustomer",
        "summary": "Read the current app customer session identity",
        "responses": {
          "200": {"description": "Current customer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CurrentCustomerSuccess"}}}},
          "401": {"description": "Authentication is required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    },
    "/api/v1/_contract/probe": {
      "post": {
        "operationId": "contractProbe",
        "summary": "Validate the generated engineering contract without business side effects",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContractProbeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated probe input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractProbeSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Input does not match the public schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Safe internal error boundary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CmsPageCode": {"name": "pageCode", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/CmsPageCode"}},
      "CatalogId": {"name": "id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/CatalogId"}},
      "CatalogCursor": {"name": "cursor", "in": "query", "schema": {"$ref": "#/components/schemas/CatalogId"}},
      "CatalogLimit": {"name": "limit", "in": "query", "schema": {"type": "string", "pattern": "^([1-9]|[1-9][0-9]|100)$"}},
      "AdminOrigin": {"name": "Origin", "in": "header", "required": true, "description": "Exact configured ADMIN_ORIGIN; browser supplies this header.", "schema": {"type": "string"}}
    },
    "responses": {"AdminError": {"description": "Standard safe error envelope (400/401/403/404/409/429/500/503)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}},
    "securitySchemes": {
      "AdminCookie": {"type": "apiKey", "in": "cookie", "name": "__Host-lingyu-admin", "description": "Development HTTP uses lingyu_admin. Independent of customer credentials."},
      "AdminCsrf": {"type": "apiKey", "in": "header", "name": "X-CSRF-Token", "description": "Session-derived value returned by login/me; required together with the HttpOnly cookie for authenticated writes."}
    },
    "schemas": {
      "CmsPageCode": {"type": "string", "enum": ["STORY", "TERMS", "PRIVACY"]},
      "CmsEmptyQuery": {"type": "object", "additionalProperties": false, "properties": {}},
      "CmsHistoryQuery": {"type": "object", "additionalProperties": false, "properties": {"before": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"}}},
      "CmsTitle": {"type": "string", "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
      "CmsBody": {"type": "string", "maxLength": 12000, "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"},
      "CmsSaveRequest": {"type": "object", "additionalProperties": false, "required": ["version", "title", "body", "reason"], "properties": {"version": {"$ref": "#/components/schemas/CatalogVersion"}, "title": {"$ref": "#/components/schemas/CmsTitle"}, "body": {"$ref": "#/components/schemas/CmsBody"}, "reason": {"const": "content_change"}}},
      "CmsPublicationRequest": {"type": "object", "additionalProperties": false, "required": ["version", "reason"], "properties": {"version": {"$ref": "#/components/schemas/CatalogVersion"}, "reason": {"const": "content_publication"}}},
      "CmsRollbackRequest": {"type": "object", "additionalProperties": false, "required": ["version", "targetVersion", "reason"], "properties": {"version": {"$ref": "#/components/schemas/CatalogVersion"}, "targetVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "reason": {"const": "content_rollback"}}},
      "CmsTextRevision": {"type": "object", "additionalProperties": false, "required": ["version", "title", "body", "publishedAt", "sourceVersion"], "properties": {"version": {"type": "integer"}, "title": {"$ref": "#/components/schemas/CmsTitle"}, "body": {"$ref": "#/components/schemas/CmsBody"}, "publishedAt": {"type": "string"}, "sourceVersion": {"type": ["integer", "null"]}}},
      "CmsPublicData": {"type": "object", "additionalProperties": false, "required": ["pageCode", "published"], "properties": {"pageCode": {"$ref": "#/components/schemas/CmsPageCode"}, "published": {"oneOf": [{"$ref": "#/components/schemas/CmsTextRevision"}, {"type": "null"}]}}},
      "CmsAdminData": {"type": "object", "additionalProperties": false, "required": ["pageCode", "version", "title", "body", "published", "history", "nextCursor", "hasMore"], "properties": {"pageCode": {"$ref": "#/components/schemas/CmsPageCode"}, "version": {"type": "integer"}, "title": {"$ref": "#/components/schemas/CmsTitle"}, "body": {"$ref": "#/components/schemas/CmsBody"}, "published": {"oneOf": [{"$ref": "#/components/schemas/CmsTextRevision"}, {"type": "null"}]}, "history": {"type": "array", "maxItems": 10, "items": {"$ref": "#/components/schemas/CmsTextRevision"}}, "nextCursor": {"type": ["string", "null"]}, "hasMore": {"type": "boolean"}}},
      "CmsSavedData": {"type": "object", "additionalProperties": false, "required": ["page", "auditId"], "properties": {"page": {"$ref": "#/components/schemas/CmsAdminData"}, "auditId": {"type": "string"}}},
      "CmsPublicSuccess": {"type": "object", "additionalProperties": false, "required": ["code", "data", "requestId"], "properties": {"code": {"const": "OK"}, "data": {"$ref": "#/components/schemas/CmsPublicData"}, "requestId": {"$ref": "#/components/schemas/RequestId"}}},
      "CmsAdminSuccess": {"type": "object", "additionalProperties": false, "required": ["code", "data", "requestId"], "properties": {"code": {"const": "OK"}, "data": {"$ref": "#/components/schemas/CmsAdminData"}, "requestId": {"$ref": "#/components/schemas/RequestId"}}},
      "CmsSavedSuccess": {"type": "object", "additionalProperties": false, "required": ["code", "data", "requestId"], "properties": {"code": {"const": "OK"}, "data": {"$ref": "#/components/schemas/CmsSavedData"}, "requestId": {"$ref": "#/components/schemas/RequestId"}}},
      "CatalogId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
      "CatalogPageRequest": {"type": "object", "additionalProperties": false, "properties": {"cursor": {"$ref": "#/components/schemas/CatalogId"}, "limit": {"type": "string", "pattern": "^([1-9]|[1-9][0-9]|100)$"}}},
      "CatalogVersion": {"type": "integer", "minimum": 0, "maximum": 2147483646},
      "CatalogName": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
      "CatalogUnit": {"type": "string", "enum": ["PIECE", "PACK", "BOX", "BOTTLE", "BAG"]},
      "CatalogOption": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, "value": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}}},
      "CatalogOptions": {"type": "array", "maxItems": 3, "items": {"$ref": "#/components/schemas/CatalogOption"}},
      "CatalogSkuDraft": {"type": "object", "additionalProperties": false, "required": ["id", "code", "unit", "options", "active", "priceMinor"], "properties": {"id": {"$ref": "#/components/schemas/CatalogId"}, "code": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,47}$"}, "unit": {"$ref": "#/components/schemas/CatalogUnit"}, "options": {"$ref": "#/components/schemas/CatalogOptions"}, "active": {"type": "boolean"}, "priceMinor": {"$ref": "#/components/schemas/DraftMinor"}}},
      "CatalogSkus": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/components/schemas/CatalogSkuDraft"}},
      "CatalogCategoryRequest": {"type": "object", "additionalProperties": false, "required": ["version", "name", "sort", "active", "reason"], "properties": {"version": {"$ref": "#/components/schemas/CatalogVersion"}, "name": {"$ref": "#/components/schemas/CatalogName"}, "sort": {"type": "integer", "minimum": 0, "maximum": 9999}, "active": {"type": "boolean"}, "reason": {"const": "catalog_change"}}},
      "CatalogCategory": {"type": "object", "additionalProperties": false, "required": ["id", "version", "name", "sort", "active"], "properties": {"id": {"$ref": "#/components/schemas/CatalogId"}, "version": {"type": "integer"}, "name": {"$ref": "#/components/schemas/CatalogName"}, "sort": {"type": "integer"}, "active": {"type": "boolean"}}},
      "CatalogProductRequest": {"type": "object", "additionalProperties": false, "required": ["version", "categoryId", "name", "description", "skus", "reason"], "properties": {"version": {"$ref": "#/components/schemas/CatalogVersion"}, "categoryId": {"$ref": "#/components/schemas/CatalogId"}, "name": {"$ref": "#/components/schemas/CatalogName"}, "description": {"type": "string", "maxLength": 1000, "pattern": "^[^\\u0000]*$"}, "skus": {"$ref": "#/components/schemas/CatalogSkus"}, "reason": {"const": "catalog_change"}}},
      "CatalogPublicationRequest": {"type": "object", "additionalProperties": false, "required": ["version", "reason"], "properties": {"version": {"$ref": "#/components/schemas/CatalogVersion"}, "reason": {"const": "publication_change"}}},
      "CatalogProductSummary": {"type": "object", "additionalProperties": false, "required": ["id", "name", "categoryId", "version", "publishedVersion"], "properties": {"id": {"$ref": "#/components/schemas/CatalogId"}, "name": {"$ref": "#/components/schemas/CatalogName"}, "categoryId": {"$ref": "#/components/schemas/CatalogId"}, "version": {"type": "integer"}, "publishedVersion": {"type": ["integer", "null"]}}},
      "CatalogProductDraft": {"type": "object", "additionalProperties": false, "required": ["id", "name", "categoryId", "description", "version", "publishedVersion", "skus", "publishedName", "publishedPrices"], "properties": {"id": {"$ref": "#/components/schemas/CatalogId"}, "name": {"$ref": "#/components/schemas/CatalogName"}, "categoryId": {"$ref": "#/components/schemas/CatalogId"}, "description": {"type": "string"}, "version": {"type": "integer"}, "publishedVersion": {"type": ["integer", "null"]}, "skus": {"$ref": "#/components/schemas/CatalogSkus"}, "publishedName": {"type": ["string", "null"]}, "publishedPrices": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "priceMinor"], "properties": {"id": {"$ref": "#/components/schemas/CatalogId"}, "priceMinor": {"$ref": "#/components/schemas/AmountMinor"}}}}}},
      "CatalogPublishedSku": {"type": "object", "additionalProperties": false, "required": ["id", "code", "unit", "options", "priceMinor", "priceVersion"], "properties": {"id": {"$ref": "#/components/schemas/CatalogId"}, "code": {"type": "string"}, "unit": {"$ref": "#/components/schemas/CatalogUnit"}, "options": {"$ref": "#/components/schemas/CatalogOptions"}, "priceMinor": {"$ref": "#/components/schemas/AmountMinor"}, "priceVersion": {"type": "integer"}}},
