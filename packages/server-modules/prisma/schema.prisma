// Business client: foundation/identity/IAM, Store, Catalog, Pricing and text CMS (no engineering probes).
generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}
datasource db {
  provider = "postgresql"
}

enum AuditSource {
  API
  WORKER
}

enum AuditActorType {
  SYSTEM
  CUSTOMER
  ADMIN
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum CustomerIdentityProvider {
  DEVELOPMENT
}

enum SessionSubjectType {
  CUSTOMER
  ADMIN
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum FulfillmentMethod {
  EXPRESS
  LOCAL_DELIVERY
  PICKUP
}

model Store {
  id                String                   @id @db.Uuid
  displayName       String                   @map("display_name") @db.VarChar(64)
  mode              String                   @default("ONLINE") @db.VarChar(16)
  version           Int                      @default(1)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  fulfillmentDrafts StoreFulfillmentDraft[]
  catalogCategories CatalogCategory[]
  catalogProducts   CatalogProduct[]
  cmsTextPages      CmsTextPage[]

  @@map("store")
}

model CmsTextPage {
  storeId          String @map("store_id") @db.Uuid
  pageCode         String @map("page_code") @db.VarChar(16)
  title            String @db.VarChar(80)
  body             String @db.Text
  version          Int @default(1)
  publishedVersion Int? @map("published_version")
  store            Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  revisions        CmsTextRevision[]
  @@id([storeId, pageCode])
  @@map("cms_text_page")
}

model CmsTextRevision {
  storeId       String @map("store_id") @db.Uuid
  pageCode      String @map("page_code") @db.VarChar(16)
  version       Int
  title         String @db.VarChar(80)
  body          String @db.Text
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  sourceVersion Int? @map("source_version")
  page          CmsTextPage @relation(fields: [storeId, pageCode], references: [storeId, pageCode], onDelete: Restrict)
  @@id([storeId, pageCode, version])
  @@map("cms_text_revision")
}

model CatalogCategory {
  id       String @id @db.Uuid
  storeId  String @map("store_id") @db.Uuid
  name     String @db.VarChar(80)
  sort     Int
  active   Boolean @default(true)
  version  Int @default(1)
  store    Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  products CatalogProduct[]
  @@unique([storeId, name])
  @@map("catalog_category")
}

model CatalogProduct {
  id               String @id @db.Uuid
  storeId          String @map("store_id") @db.Uuid
  categoryId       String @map("category_id") @db.Uuid
  name             String @db.VarChar(80)
  description      String @db.VarChar(1000)
  version          Int @default(1)
  publishedVersion Int? @map("published_version")
  store            Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category         CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  skus             CatalogSku[]
  publications     CatalogPublication[]
  @@index([storeId, id])
  @@map("catalog_product")
}

model CatalogSku {
  id           String @id @db.Uuid
  productId    String @map("product_id") @db.Uuid
  code         String @unique @db.VarChar(48)
  unit         String @db.VarChar(8)
  options      Json
  optionsKey   String @map("options_key") @db.VarChar(1200)
  active       Boolean @default(true)
  product      CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  publications CatalogPublishedSku[]
  draftPrice   SkuPriceDraft?
  priceVersions SkuPriceVersion[]
  @@unique([productId, optionsKey])
  @@map("catalog_sku")
}

model CatalogPublication {
  productId    String @map("product_id") @db.Uuid
  version      Int
  name         String @db.VarChar(80)
  description  String @db.VarChar(1000)
  categoryId   String @map("category_id") @db.Uuid
  categoryName String @map("category_name") @db.VarChar(80)
  categorySort Int @map("category_sort")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product      CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  skus         CatalogPublishedSku[]
  prices       SkuPriceVersion[]
  @@id([productId, version])
  @@map("catalog_publication")
}

model CatalogPublishedSku {
  productId   String @map("product_id") @db.Uuid
  version     Int
  skuId       String @map("sku_id") @db.Uuid
  publication CatalogPublication @relation(fields: [productId, version], references: [productId, version], onDelete: Restrict)
  sku         CatalogSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  @@id([productId, version, skuId])
  @@map("catalog_published_sku")
}

// Pricing owns these tables; Catalog calls its public transactional interface.
model SkuPriceDraft {
  skuId      String @id @map("sku_id") @db.Uuid
  priceMinor BigInt? @map("price_minor")
  sku        CatalogSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  @@map("sku_price_draft")
}

model SkuPriceVersion {
  productId   String @map("product_id") @db.Uuid
  version     Int
  skuId       String @map("sku_id") @db.Uuid
  priceMinor  BigInt @map("price_minor")
  publication CatalogPublication @relation(fields: [productId, version], references: [productId, version], onDelete: Restrict)
  sku         CatalogSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  @@id([productId, version, skuId])
  @@map("sku_price_version")
}

model StoreFulfillmentDraft {
  storeId            String            @map("store_id") @db.Uuid
  method             FulfillmentMethod
  feeMinor           BigInt?           @map("fee_minor")
  freeAboveMinor     BigInt?           @map("free_above_minor")
  serviceDescription String?           @map("service_description") @db.VarChar(500)
  pickupAddress      String?           @map("pickup_address") @db.VarChar(200)
  store              Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@id([storeId, method])
  @@map("store_fulfillment_draft")
}

enum AdminRoleName {
  IAM_MANAGER
  STORE_OPERATOR
  STORE_READER
}

model AdminAccount {
  id               String       @id @db.Uuid
  username         String       @unique @db.VarChar(64)
  passwordHash     String       @map("password_hash") @db.VarChar(256)
  status           AdminStatus  @default(ACTIVE)
  version          Int          @default(1)
  failedLoginCount Int          @default(0) @map("failed_login_count")
  lockedUntil      DateTime?    @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  grants           AdminGrant[]
  sessions         AdminSession[]

  @@map("admin_account")
}

model AdminGrant {
  id       String        @id @db.Uuid
  adminId  String        @map("admin_id") @db.Uuid
  role     AdminRoleName
  scopeKey String        @map("scope_key") @db.VarChar(36)
  admin    AdminAccount  @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@unique([adminId, role, scopeKey])
  @@map("admin_grant")
}

model AdminSession {
  id         String       @id @db.Uuid
  adminId    String       @map("admin_id") @db.Uuid
  digest     String       @db.VarChar(64)
  version    Int
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  admin      AdminAccount @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, expiresAt])
  @@map("admin_session")
}

model Customer {
  id         String         @id @db.Uuid
  status     CustomerStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities CustomerIdentity[]

  @@map("customer")
  @@index([status])
}

model CustomerIdentity {
  id          String                   @id @db.Uuid
  customerId  String                   @map("customer_id") @db.Uuid
  provider    CustomerIdentityProvider
  providerKey String                   @unique @map("provider_key") @db.VarChar(256)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  customer    Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("customer_identity")
  @@index([customerId])
}

model Session {
  id                String             @id @db.Uuid
  subjectId         String             @map("subject_id") @db.Uuid
  subjectType       SessionSubjectType @map("subject_type")
  developmentOnly   Boolean            @default(true) @map("development_only")
  refreshHash       String             @map("refresh_hash") @db.VarChar(128)
  refreshExpiresAt  DateTime           @map("refresh_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?            @map("revoke_reason") @db.VarChar(64)
  lastUsedAt        DateTime           @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  usedRefreshTokens UsedRefreshToken[]

  @@map("session")
  @@index([subjectId, subjectType])
  @@index([refreshExpiresAt])
}

model UsedRefreshToken {
  sessionId String   @map("session_id") @db.Uuid
  digest    String   @db.VarChar(64)
  usedAt    DateTime @default(now()) @map("used_at") @db.Timestamptz(6)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, digest])
  @@map("used_refresh_token")
}

model AuditLog {
  id             String         @id @db.Uuid
  source         AuditSource
  actorType      AuditActorType?
  actorId        String?        @db.VarChar(128)
  action         String         @db.VarChar(100)
  objectType     String         @db.VarChar(100)
  objectId       String         @db.VarChar(128)
  requestId      String?        @db.VarChar(64)
  idempotencyKey String?        @db.VarChar(128)
  changes        Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_log")
  @@index([objectType, objectId])
  @@index([requestId])
  @@index([idempotencyKey])
}
