// Business client only: foundation audit, customer identity and independent admin IAM.
generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}
datasource db {
  provider = "postgresql"
}

enum AuditSource {
  API
  WORKER
}

enum AuditActorType {
  SYSTEM
  CUSTOMER
  ADMIN
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum CustomerIdentityProvider {
  DEVELOPMENT
}

enum SessionSubjectType {
  CUSTOMER
  ADMIN
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum FulfillmentMethod {
  EXPRESS
  LOCAL_DELIVERY
  PICKUP
}

model Store {
  id                String                   @id @db.Uuid
  displayName       String                   @map("display_name") @db.VarChar(64)
  mode              String                   @default("ONLINE") @db.VarChar(16)
  version           Int                      @default(1)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  fulfillmentDrafts StoreFulfillmentDraft[]

  @@map("store")
}

model StoreFulfillmentDraft {
  storeId            String            @map("store_id") @db.Uuid
  method             FulfillmentMethod
  feeMinor           BigInt?           @map("fee_minor")
  freeAboveMinor     BigInt?           @map("free_above_minor")
  serviceDescription String?           @map("service_description") @db.VarChar(500)
  pickupAddress      String?           @map("pickup_address") @db.VarChar(200)
  store              Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@id([storeId, method])
  @@map("store_fulfillment_draft")
}

enum AdminRoleName {
  IAM_MANAGER
  STORE_OPERATOR
  STORE_READER
}

model AdminAccount {
  id               String       @id @db.Uuid
  username         String       @unique @db.VarChar(64)
  passwordHash     String       @map("password_hash") @db.VarChar(256)
  status           AdminStatus  @default(ACTIVE)
  version          Int          @default(1)
  failedLoginCount Int          @default(0) @map("failed_login_count")
  lockedUntil      DateTime?    @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  grants           AdminGrant[]
  sessions         AdminSession[]

  @@map("admin_account")
}

model AdminGrant {
  id       String        @id @db.Uuid
  adminId  String        @map("admin_id") @db.Uuid
  role     AdminRoleName
  scopeKey String        @map("scope_key") @db.VarChar(36)
  admin    AdminAccount  @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@unique([adminId, role, scopeKey])
  @@map("admin_grant")
}

model AdminSession {
  id         String       @id @db.Uuid
  adminId    String       @map("admin_id") @db.Uuid
  digest     String       @db.VarChar(64)
  version    Int
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  admin      AdminAccount @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, expiresAt])
  @@map("admin_session")
}

model Customer {
  id         String         @id @db.Uuid
  status     CustomerStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities CustomerIdentity[]

  @@map("customer")
  @@index([status])
}

model CustomerIdentity {
  id          String                   @id @db.Uuid
  customerId  String                   @map("customer_id") @db.Uuid
  provider    CustomerIdentityProvider
  providerKey String                   @unique @map("provider_key") @db.VarChar(256)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  customer    Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("customer_identity")
  @@index([customerId])
}

model Session {
  id                String             @id @db.Uuid
  subjectId         String             @map("subject_id") @db.Uuid
  subjectType       SessionSubjectType @map("subject_type")
  developmentOnly   Boolean            @default(true) @map("development_only")
  refreshHash       String             @map("refresh_hash") @db.VarChar(128)
  refreshExpiresAt  DateTime           @map("refresh_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?            @map("revoke_reason") @db.VarChar(64)
  lastUsedAt        DateTime           @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  usedRefreshTokens UsedRefreshToken[]

  @@map("session")
  @@index([subjectId, subjectType])
  @@index([refreshExpiresAt])
}

model UsedRefreshToken {
  sessionId String   @map("session_id") @db.Uuid
  digest    String   @db.VarChar(64)
  usedAt    DateTime @default(now()) @map("used_at") @db.Timestamptz(6)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, digest])
  @@map("used_refresh_token")
}

model AuditLog {
  id             String         @id @db.Uuid
  source         AuditSource
  actorType      AuditActorType?
  actorId        String?        @db.VarChar(128)
  action         String         @db.VarChar(100)
  objectType     String         @db.VarChar(100)
  objectId       String         @db.VarChar(128)
  requestId      String?        @db.VarChar(64)
  idempotencyKey String?        @db.VarChar(128)
  changes        Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_log")
  @@index([objectType, objectId])
  @@index([requestId])
  @@index([idempotencyKey])
}
